{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["global", "images", "hosts", "config", "secrets", "api", "web", "admin", "envoy", "ingress"],
  "properties": {
    "global": { "type": "object" },
    "images": { "type": "object" },
    "hosts": { "type": "object" },
    "config": { "type": "object" },
    "secrets": {
      "type": "object",
      "required": ["create", "name", "values"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "values": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "api": { "$ref": "#/$defs/httpWorkload" },
    "web": { "$ref": "#/$defs/httpWorkload" },
    "admin": { "$ref": "#/$defs/httpWorkload" },
    "envoy": { "$ref": "#/$defs/httpWorkload" },
    "ingress": { "type": "object" },
    "networkPolicy": { "type": "object" }
  },
  "$defs": {
    "httpWorkload": {
      "type": "object",
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "type": "object" }
      }
    }
  }
}

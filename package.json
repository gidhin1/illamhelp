{
  "name": "illamhelp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev:api": "mvn -f api-java/pom.xml spring-boot:run",
    "dev:web": "corepack pnpm --filter @illamhelp/web dev",
    "dev:admin": "corepack pnpm --filter @illamhelp/admin dev",
    "dev:mobile": "corepack pnpm --filter @illamhelp/mobile start",
    "build": "mvn -f api-java/pom.xml package && corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "mvn -f api-java/pom.xml verify && corepack pnpm -r test",
    "test:ui:web": "bash ./scripts/run-with-e2e-admin-env.sh bash ./scripts/run-playwright-suite.sh tests/playwright/playwright.web.config.ts",
    "test:ui:admin": "bash ./scripts/run-with-e2e-admin-env.sh bash ./scripts/run-playwright-suite.sh tests/playwright/playwright.admin.config.ts",
    "test:ui:mobile": "bash ./scripts/run-with-e2e-admin-env.sh bash ./scripts/run-playwright-suite.sh tests/playwright/playwright.mobile.config.ts",
    "test:ui": "corepack pnpm run test:ui:web && corepack pnpm run test:ui:admin && corepack pnpm run test:ui:mobile",
    "test:ui:install": "playwright install chromium",
    "infra:up": "docker compose --project-name illamhelp --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --project-name illamhelp --env-file .env -f infra/docker-compose.yml down -v --remove-orphans",
    "test:ui:migration": "playwright test -c tests/playwright/playwright.migration.config.ts"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3.1.2": "3.1.4",
      "glob@6>minimatch": "3.1.4",
      "glob@7>minimatch": "3.1.4",
      "glob@10>minimatch": "9.0.7",
      "glob@11>minimatch": "10.2.3",
      "glob@13>minimatch": "10.2.3",
      "@expo/cli>tar": "7.5.21",
      "cacache>tar": "7.5.21",
      "@babel/preset-env>@babel/plugin-transform-modules-systemjs": "7.29.4",
      "@expo/plist>@xmldom/xmldom": "0.8.15",
      "plist>@xmldom/xmldom": "0.8.15",
      "node-forge": "1.4.1",
      "picomatch@2.3.1": "2.3.2",
      "form-data@3.0.4": "3.0.5",
      "undici@6.24.0": "6.29.1",
      "ws@6.2.3": "6.2.4",
      "ws@7.5.10": "7.5.11",
      "ws@8.19.0": "8.21.0",
      "brace-expansion@1": "1.1.20",
      "brace-expansion@5": "5.0.11",
      "browserslist@4": "4.28.7",
      "compression@1": "1.8.2",
      "metro@0.82.5>image-size": "2.0.3",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "nanoid@3": "3.3.18",
      "postcss@8": "8.5.18",
      "sharp@0.34": "0.35.5",
      "shell-quote@1": "1.11.0",
      "source-map-js@1": "1.2.2",
      "query-string@7>decode-uri-component": "0.5.1",
      "eslint-config-next>eslint-plugin-react-hooks": "7.0.1"
    },
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "dtrace-provider",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "metro@0.82.5": "patches/metro@0.82.5.patch",
      "query-string@7.1.3": "patches/query-string@7.1.3.patch"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.8",
    "vite": "^7.2.7",
    "vitest": "^4.1.8"
  }
}

meta {
  name: Media Upload Ticket
  type: grpc
  seq: 16
  tags: [
    manual
  ]
}

grpc {
  url: grpc://localhost:9090
  method: /media.v1.MediaService/CreateUploadTicket
  protoPath: ../../api-java/src/main/protobuf/media/v1/media.proto
  methodType: unary
  auth: none
}

metadata {
  authorization: Bearer {{seekerAccessToken}}
}

body:grpc {
  name: message 1
  content: '''
    {
      "kind": "MEDIA_KIND_IMAGE",
      "content_type": "image/jpeg",
      "file_size_bytes": 512,
      "checksum_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "original_file_name": "e2e-id-proof.jpg",
      "purpose": "MEDIA_PURPOSE_VERIFICATION_DOCUMENT"
    }
  '''
}

tests {
  test("media upload ticket returns media id", function () {
    const body = res.body || {};
    expect(body.media_id || body.mediaId).to.be.a("string");
  });

  test("media upload ticket returns required fields", function () {
    const body = res.body || {};
    expect(body.upload_url || body.uploadUrl).to.be.a("string");
    expect(body.bucket_name || body.bucketName).to.be.a("string");
    expect(body.object_key || body.objectKey).to.be.a("string");
  });
}

script:post-response {
  const body = res.body || {};
  const mediaId = body.media_id || body.mediaId;
  const uploadUrl = body.upload_url || body.uploadUrl;
  const headers = body.required_headers || body.requiredHeaders || {};
  bru.setEnvVar("mediaId", mediaId);
  bru.setEnvVar("mediaUploadUrl", uploadUrl);
  bru.setEnvVar("mediaUploadHeaders", JSON.stringify(headers));
  bru.runner.setNextRequest("Media Complete Upload");
}
